# Autopilot TG bot credentials — заполняется install.sh или вручную.
# НИКОГДА не коммитить — этот файл должен быть в .gitignore.

# Bot token из @BotFather (https://t.me/BotFather → /newbot)
AUTOPILOT_TG_BOT_TOKEN=

# chat_id владельца (= user_id в private chat). Получается через discover_chat_id.sh
AUTOPILOT_TG_CHAT_ID=

# user_id (numeric, R2 strong auth) — в private chat = chat_id
AUTOPILOT_TG_ALLOWED_USER_ID=

# Username для логов (mutable, не для auth)
AUTOPILOT_TG_ALLOWED_USERNAME=
