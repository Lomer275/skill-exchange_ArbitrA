        "properties": {
          "unit": {"type": "string"},
          "entry": {"type": "string"},
          "modules": {"type": "integer", "minimum": 0},
          "outside_git_lines": {"type": "integer", "minimum": 0},
          "ignored_lines": {"type": "integer", "minimum": 0},
          "uncommitted_add": {"type": "integer", "minimum": 0},
          "uncommitted_del": {"type": "integer", "minimum": 0},
          "ahead_closure": {"type": "integer", "minimum": 0},
          "ahead_verified": {"type": "boolean"}
        }
      }
    },
    "shared_locks": {
      "type": "array",
      "items": {
