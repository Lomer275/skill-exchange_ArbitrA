    "log_lock_refusals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["log", "mode", "runs", "refusals", "successes", "share", "heuristic"],
        "properties": {
          "log": {"type": "string"},
          "mode": {"type": "string"},
          "runs": {"type": "integer", "minimum": 0},
          "refusals": {"type": "integer", "minimum": 0},
          "successes": {"type": "integer", "minimum": 0},
          "share": {"type": ["number", "null"], "minimum": 0},
          "heuristic": {"const": true}
        }
      }
    },
    "recently_modified_in_live_dirs": {"type": "integer", "minimum": 0},
    "destructive_api_calls": {"type": "integer", "minimum": 0}
