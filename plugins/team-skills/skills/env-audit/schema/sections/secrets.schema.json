{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:env-audit:sections:secrets",
  "type": ["object", "null"],
  "additionalProperties": false,
  "required": [
    "lower_bound",
    "timings_s",
    "positive_controls",
    "generic_assignment_scope",
    "context_files",
    "context_generic_assignment",
    "agent_configs",
    "agent_configs_generic_assignment",
    "roots",
    "home",
    "agent_histories",
    "shell_history",
    "config_dir",
    "storage",
    "ssh_keys",
    "authorized_keys",
    "external_access"
  ],
  "properties": {
    "lower_bound": {"const": true},
    "timings_s": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_controls", "context_files", "agent_configs", "roots", "home", "agent_histories", "shell_history", "config_dir", "storage", "ssh_keys", "external"],
      "properties": {
        "positive_controls": {"type": "number", "minimum": 0},
        "context_files": {"type": "number", "minimum": 0},
        "agent_configs": {"type": "number", "minimum": 0},
        "roots": {"type": "number", "minimum": 0},
        "home": {"type": "number", "minimum": 0},
        "agent_histories": {"type": "number", "minimum": 0},
        "shell_history": {"type": "number", "minimum": 0},
        "config_dir": {"type": "number", "minimum": 0},
        "storage": {"type": "number", "minimum": 0},
        "ssh_keys": {"type": "number", "minimum": 0},
        "external": {"type": "number", "minimum": 0}
      }
    },
    "positive_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree", "git_head", "git_history", "configs", "home"],
      "properties": {
        "tree": {"enum": ["pass", "fail"]},
        "git_head": {"enum": ["pass", "fail"]},
        "git_history": {"enum": ["pass", "fail"]},
        "configs": {"enum": ["pass", "fail"]},
        "home": {"enum": ["pass", "fail"]}
      }
    },
    "generic_assignment_scope": {
      "const": ["context_files", "agent_configs", "shell_history", "config_dir"]
    },
    "context_files": {
      "type": "array",
      "items": {"$ref": "#/$defs/context_file"}
    },
    "context_generic_assignment": {"$ref": "#/$defs/generic_assignment_counts"},
    "agent_configs": {
      "type": ["array", "null"],
      "items": {"$ref": "#/$defs/agent_config"}
    },
    "agent_configs_generic_assignment": {"$ref": "#/$defs/generic_assignment_counts"},
    "roots": {
      "type": ["object", "null"],
      "additionalProperties": {"$ref": "#/$defs/root"}
    },
    "home": {"$ref": "#/$defs/home_summary_or_null"},
    "agent_histories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude_transcripts", "claude_subagents", "codex_sessions"],
      "properties": {
        "claude_transcripts": {"$ref": "#/$defs/agent_history"},
        "claude_subagents": {"$ref": "#/$defs/agent_history"},
        "codex_sessions": {"$ref": "#/$defs/agent_history"}
      }
    },
    "shell_history": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["files", "with_matches", "by_class"],
      "properties": {
        "files": {"type": "integer", "minimum": 0},
        "with_matches": {"type": "integer", "minimum": 0},
        "by_class": {"type": "object"}
      }
    },
    "config_dir": {"$ref": "#/$defs/summary_or_null"},
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secrets_dirs"],
      "properties": {
        "secrets_dirs": {
          "type": "array",
          "items": {"$ref": "#/$defs/directory"}
        }
      }
    },
    "ssh_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "type", "mode", "wider_than_600", "encrypted"],
        "properties": {
          "file": {"type": "string"},
          "type": {"enum": ["OPENSSH", "RSA", "EC", "DSA", "UNKNOWN"]},
          "mode": {"type": ["string", "null"]},
          "wider_than_600": {"type": "boolean"},
          "encrypted": {"type": ["boolean", "null"]}
        }
      }
    },
    "authorized_keys": {"type": "integer", "minimum": 0},
    "external_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gh_hosts", "docker_registries", "aws_profiles", "kube_contexts"],
      "properties": {
        "gh_hosts": {"type": "array", "items": {"type": "string"}},
        "docker_registries": {"type": "array", "items": {"type": "string"}},
        "aws_profiles": {"type": "integer", "minimum": 0},
        "kube_contexts": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "generic_assignment_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "matches"],
      "properties": {
        "files": {"type": "integer", "minimum": 0},
        "matches": {"type": "integer", "minimum": 0}
      }
    },
    "class_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["matches", "distinct", "user_ids"],
        "properties": {
          "matches": {"type": "integer", "minimum": 0},
          "distinct": {"type": "integer", "minimum": 0},
          "user_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "context_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "tracked", "classes"],
      "properties": {
        "path": {"type": "string"},
        "kind": {"enum": ["claude_md", "agents_md", "readme", "memory", "user_skill", "project_skill", "project_command"]},
        "tracked": {"type": ["boolean", "null"]},
        "classes": {"$ref": "#/$defs/class_counts"}
      }
    },
    "agent_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "is_backup", "mode", "env_keys_with_secret", "allow_rules_with_secret", "other_matches", "classes"],
      "properties": {
        "path": {"type": "string"},
        "is_backup": {"type": "boolean"},
        "mode": {"type": ["string", "null"]},
        "env_keys_with_secret": {"type": "integer", "minimum": 0},
        "allow_rules_with_secret": {"type": "integer", "minimum": 0},
        "other_matches": {"type": "integer", "minimum": 0},
        "classes": {"$ref": "#/$defs/class_counts"}
      }
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "files", "files_wider_than_600"],
      "properties": {
        "path": {"type": "string"},
        "mode": {"type": ["string", "null"]},
        "files": {"type": "integer", "minimum": 0},
        "files_wider_than_600": {"type": "integer", "minimum": 0}
      }
    },
    "summary_or_null": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "home_summary_or_null": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "required": ["excluded_worktrees", "not_reached"],
      "properties": {
        "excluded_worktrees": {"type": "integer", "minimum": 0},
        "not_reached": {
          "type": "array",
          "maxItems": 30,
          "items": {"type": "string"}
        }
      }
    },
    "agent_history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "files_scanned", "files_with_hits", "by_class", "bytes_read", "window_days", "truncated", "lower_bound", "paths_sample"],
      "properties": {
        "present": {"type": "boolean"},
        "files_scanned": {"type": "integer", "minimum": 0},
        "files_with_hits": {"type": "integer", "minimum": 0},
        "by_class": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "bytes_read": {"type": "integer", "minimum": 0, "maximum": 2147483648},
        "window_days": {"const": 30},
        "truncated": {"type": "boolean"},
        "lower_bound": {"const": true},
        "paths_sample": {
          "type": "array",
          "maxItems": 10,
          "items": {"type": "string"}
        }
      }
    },
    "env_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "tracked", "ignored", "symlink", "symlink_target_inside_root", "mode", "identical_to_ignored_env", "value_classes", "ci_referenced"],
      "properties": {
        "path": {"type": "string"},
        "tracked": {"type": ["boolean", "null"]},
        "ignored": {"type": ["boolean", "null"]},
        "symlink": {"type": "boolean"},
        "symlink_target_inside_root": {"type": ["boolean", "null"]},
        "mode": {"type": ["string", "null"]},
        "identical_to_ignored_env": {"type": "boolean"},
        "value_classes": {"type": "array", "items": {"type": "string"}},
        "ci_referenced": {"type": "boolean"}
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcs", "patterns", "env_like_files", "secrets_dir", "pii_files", "build_context", "archives", "windowed_files", "size_cap_files"],
      "properties": {
        "vcs": {"type": "boolean"},
        "patterns": {"type": "object"},
        "env_like_files": {"type": "array", "items": {"$ref": "#/$defs/env_file"}},
        "secrets_dir": {"oneOf": [{"$ref": "#/$defs/directory"}, {"type": "null"}]},
        "pii_files": {"type": "array", "items": {"type": "object"}},
        "build_context": {"type": "object"},
        "archives": {"type": "array", "items": {"type": "object"}},
        "windowed_files": {"type": "integer", "minimum": 0},
        "size_cap_files": {"type": "integer", "minimum": 0}
      }
    }
  }
}
