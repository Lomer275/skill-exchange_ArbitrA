{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:env-audit:section:tokens",
  "type": "object",
  "additionalProperties": false,
  "required": ["window_days", "claude", "codex", "codex_share_14"],
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cache_creation", "cache_read"],
      "properties": {
        "input": {"type": "integer", "minimum": 0},
        "output": {"type": "integer", "minimum": 0},
        "cache_creation": {"type": "integer", "minimum": 0},
        "cache_read": {"type": "integer", "minimum": 0}
      }
    },
    "model_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cache_creation", "cache_read", "messages"],
      "properties": {
        "input": {"type": "integer", "minimum": 0},
        "output": {"type": "integer", "minimum": 0},
        "cache_creation": {"type": "integer", "minimum": 0},
        "cache_read": {"type": "integer", "minimum": 0},
        "messages": {"type": "integer", "minimum": 0}
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "messages", "by_model", "subagents_total"],
      "properties": {
        "total": {"$ref": "#/$defs/usage"},
        "messages": {"type": "integer", "minimum": 0},
        "by_model": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/model_usage"}
        },
        "subagents_total": {"$ref": "#/$defs/usage"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache_read", "share"],
      "properties": {
        "cache_read": {"type": "integer", "minimum": 0},
        "share": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "period_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["14", "30"],
      "properties": {
        "14": {"type": "integer", "minimum": 0},
        "30": {"type": "integer", "minimum": 0}
      }
    },
    "codex_total": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "cached_input", "cache_write_input", "output", "reasoning_output", "total"],
      "properties": {
        "input": {"type": "integer", "minimum": 0},
        "cached_input": {"type": "integer", "minimum": 0},
        "cache_write_input": {"type": "integer", "minimum": 0},
        "output": {"type": "integer", "minimum": 0},
        "reasoning_output": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    }
  },
  "properties": {
    "window_days": {"type": "integer", "minimum": 1},
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_read", "bad_lines", "duplicates_dropped", "periods", "by_source", "loop_invocations", "loop_refires", "inferred_human_turns"],
      "properties": {
        "files_read": {"type": "integer", "minimum": 0},
        "bad_lines": {"type": "integer", "minimum": 0},
        "duplicates_dropped": {"type": "integer", "minimum": 0},
        "periods": {
          "type": "object",
          "additionalProperties": false,
          "required": ["14", "30"],
          "properties": {
            "14": {"anyOf": [{"$ref": "#/$defs/period"}, {"type": "null"}]},
            "30": {"anyOf": [{"$ref": "#/$defs/period"}, {"type": "null"}]}
          }
        },
        "by_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["human", "task-notification", "peer", "loop", "unknown"],
          "properties": {
            "human": {"$ref": "#/$defs/source"},
            "task-notification": {"$ref": "#/$defs/source"},
            "peer": {"$ref": "#/$defs/source"},
            "loop": {"$ref": "#/$defs/source"},
            "unknown": {"$ref": "#/$defs/source"}
          }
        },
        "loop_invocations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["human", "task-notification", "peer", "unknown"],
          "properties": {
            "human": {"type": "integer", "minimum": 0},
            "task-notification": {"type": "integer", "minimum": 0},
            "peer": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0}
          }
        },
        "loop_refires": {"type": "integer", "minimum": 0},
        "inferred_human_turns": {"type": "integer", "minimum": 0}
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "present", "sessions", "subagent_sessions", "totals"],
      "properties": {
        "home": {"type": "string"},
        "present": {"type": "boolean"},
        "sessions": {"$ref": "#/$defs/period_counts"},
        "subagent_sessions": {"$ref": "#/$defs/period_counts"},
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["14", "30"],
          "properties": {
            "14": {"$ref": "#/$defs/codex_total"},
            "30": {"$ref": "#/$defs/codex_total"}
          }
        }
      }
    },
    "codex_share_14": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude_code_edits", "claude_other_edits", "codex_sessions", "codex_skill_invocations"],
      "properties": {
        "claude_code_edits": {"type": "integer", "minimum": 0},
        "claude_other_edits": {"type": "integer", "minimum": 0},
        "codex_sessions": {"type": "integer", "minimum": 0},
        "codex_skill_invocations": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
