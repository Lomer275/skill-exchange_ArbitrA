#!/usr/bin/env python3
"""
Pre-commit hook: validates skills, regenerates skills/index.json and README.md.
Install via: python cli/skill_exchange.py setup-hooks
"""
import subprocess
import sys
from pathlib import Path

result = subprocess.run(
    ["git", "rev-parse", "--show-toplevel"],
    capture_output=True, text=True, check=True,
)
repo_root = Path(result.stdout.strip())
sys.path.insert(0, str(repo_root / "cli"))

import re

# --- барьер от секретов (18.08.2026, после утечки боевого вебхука) ---
# Правило в references/pitfalls.md §9 существовало с 12.08 и не сработало: его никто
# не проверял машинно. Теперь проверяет хук.
SECRET_PATTERNS = [
    (re.compile(rb"/rest/\d+/[A-Za-z0-9]{10,}"), "входящий вебхук Битрикса"),
    (re.compile(rb"-----BEGIN [A-Z ]*PRIVATE KEY"), "приватный ключ"),
    (re.compile(rb"(?i)(api[_-]?key|secret|token|password)\s*[:=]\s*\S{16,}"), "ключ или пароль значением"),
]
ALLOW_MARKERS = (b"example.tld", b"BITRIX_WEBHOOK", b"<user>", b"<token>", b"REDACTED", b"YOUR_")

_staged = subprocess.run(
    ["git", "diff", "--cached", "--name-only", "-z", "--diff-filter=ACM"],
    capture_output=True, check=True,
).stdout.split(b"\x00")

_found = []
for _raw in _staged:
    if not _raw:
        continue
    _name = _raw.decode("utf-8", "surrogateescape")
    try:
        _blob = (Path(_name)).read_bytes()
    except OSError:
        continue
    if b"\x00" in _blob[:1024]:
        continue
    for _no, _line in enumerate(_blob.splitlines(), 1):
        if any(_m in _line for _m in ALLOW_MARKERS):
            continue
        for _rx, _what in SECRET_PATTERNS:
            if _rx.search(_line):
                _found.append("%s:%d — %s" % (_name, _no, _what))
                break

if _found:
    print("[pre-commit] ОТКЛОНЕНО: в коммит попал секрет.", file=sys.stderr)
    for _f in _found[:20]:
        print("  - " + _f, file=sys.stderr)
    print("[pre-commit] Репозиторий публичный: значение уедет всем и останется в истории.", file=sys.stderr)
    print("[pre-commit] Замени на переменную или плейсхолдер.", file=sys.stderr)
    sys.exit(1)

import indexer

errors = indexer.validate_all()
if errors:
    print("[pre-commit] Валидация скиллов провалена:", file=sys.stderr)
    for e in errors:
        print(f"  - {e}", file=sys.stderr)
    print("[pre-commit] Коммит отклонён. Исправь ошибки и попробуй снова.", file=sys.stderr)
    sys.exit(1)

skills = indexer.scan_skills()
indexer.write_index(skills)

readme_content = indexer.generate_readme(skills)
(repo_root / "README.md").write_text(readme_content, encoding="utf-8")

index_rel = indexer.INDEX_FILE.relative_to(repo_root).as_posix()
subprocess.run(
    ["git", "add", index_rel, "README.md"],
    cwd=repo_root,
    check=True,
)
print(f"[pre-commit] Каталог обновлён: {len(skills)} скилл(ов)")
