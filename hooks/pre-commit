#!/usr/bin/env python3
"""
Pre-commit hook: validates skills, regenerates skills/index.json and README.md.
Install via: python cli/skill_exchange.py setup-hooks
"""
import subprocess
import sys
from pathlib import Path

result = subprocess.run(
    ["git", "rev-parse", "--show-toplevel"],
    capture_output=True, text=True, check=True,
)
repo_root = Path(result.stdout.strip())
sys.path.insert(0, str(repo_root / "cli"))

import indexer

errors = indexer.validate_all()
if errors:
    print("[pre-commit] Валидация скиллов провалена:", file=sys.stderr)
    for e in errors:
        print(f"  - {e}", file=sys.stderr)
    print("[pre-commit] Коммит отклонён. Исправь ошибки и попробуй снова.", file=sys.stderr)
    sys.exit(1)

skills = indexer.scan_skills()
indexer.write_index(skills)

readme_content = indexer.generate_readme(skills)
(repo_root / "README.md").write_text(readme_content, encoding="utf-8")

index_rel = indexer.INDEX_FILE.relative_to(repo_root).as_posix()
subprocess.run(
    ["git", "add", index_rel, "README.md"],
    cwd=repo_root,
    check=True,
)
print(f"[pre-commit] Каталог обновлён: {len(skills)} скилл(ов)")
